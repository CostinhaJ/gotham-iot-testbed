# MQTT client for the IoT device, com decisão adaptativa de protocolo (XGBoost).
# Baseado no Dockerfile original do dispositivo MQTT do projeto.
 
FROM ubuntu:focal
 
RUN apt update && apt install -y --no-install-recommends \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*
 
RUN pip3 install --no-cache-dir paho-mqtt xgboost scikit-learn joblib numpy
 
# Certificado da CA do projeto, para o cliente poder validar o broker em TLS.
# Usa a mesma imagem de certificados que o Dockerfile.tls do broker já usa.
COPY --from=iotsim/certificates:latest /artifacts/pki/iot-sim-ca.crt /iot-sim-ca.crt
 
# Os 5 artefactos gerados pelo script de treino (modelo + scaler + encoders).
COPY models/context_classifier.joblib /context_classifier.joblib
COPY models/context_regressor.joblib /context_regressor.joblib
COPY models/context_scaler.joblib /context_scaler.joblib
COPY models/context_e_alg_encoder.joblib /context_e_alg_encoder.joblib
COPY models/context_data_type_encoder.joblib /context_data_type_encoder.joblib
 
COPY client.py /client.py
RUN chmod +x /client.py
 
ENTRYPOINT ["/client.py"]
 